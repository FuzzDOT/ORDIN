# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Docker ignore file - excludes files from Docker build context

# Git
.git
.gitignore

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Documentation
docs/
*.md
!README.md

# Tests (not needed in production image)
tests/
*_test.py
test_*.py

# Development files
.env
.env.*
!.env.example
requirements-dev.txt
Makefile
docker-compose*.yml

# Build artifacts
build/
dist/
*.egg-info/

# Local files
*.local
*.log
tmp/
temp/

# macOS
.DS_Store

# Secrets
*.pem
*.key
secrets/
credentials/
service-account*.json
