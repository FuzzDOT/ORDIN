# =============================================================================
# ORDIN Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment.
# NEVER commit .env files with real credentials to version control.
#
# All variables are prefixed with ORDIN_ to avoid collisions.
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------

# Application name (used in logs and metrics)
ORDIN_APP_NAME=ordin-backend

# Application version
ORDIN_APP_VERSION=0.1.0

# Deployment environment: dev | staging | prod
ORDIN_ENV=dev

# Enable debug mode (MUST be false in production)
ORDIN_DEBUG=true

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server bind address (use 0.0.0.0 for container deployment)
ORDIN_HOST=0.0.0.0

# Server port
ORDIN_PORT=8000

# Number of worker processes (use 1 for Kubernetes, scale via replicas)
ORDIN_WORKERS=1

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
ORDIN_LOG_LEVEL=DEBUG

# Log format: json (production) | text (development)
ORDIN_LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Request Processing
# -----------------------------------------------------------------------------

# Request timeout in seconds
ORDIN_REQUEST_TIMEOUT_SECONDS=30

# Maximum request body size in bytes (default: 10MB)
ORDIN_MAX_REQUEST_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins (for frontend integration)
ORDIN_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Allow credentials in CORS requests
ORDIN_CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Firebase Authentication Configuration
# -----------------------------------------------------------------------------

# Enable/disable Firebase authentication
# Set to false for local development without auth
ORDIN_FIREBASE_AUTH_ENABLED=true

# Firebase project ID (required in production when auth is enabled)
ORDIN_FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account JSON file
# If not set, uses Application Default Credentials (ADC)
# For local dev, you can download this from Firebase Console > Project Settings > Service Accounts
# ORDIN_FIREBASE_CREDENTIALS_PATH=/path/to/service-account.json

# Firebase Auth Emulator host for local development
# Set this when using Firebase Emulator Suite
# ORDIN_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# -----------------------------------------------------------------------------
# Future: Database Configuration (placeholder)
# -----------------------------------------------------------------------------

# DATABASE_URL=postgresql://user:password@localhost:5432/ordin

# -----------------------------------------------------------------------------
# Future: Redis Configuration (placeholder)
# -----------------------------------------------------------------------------

# REDIS_URL=redis://localhost:6379/0
